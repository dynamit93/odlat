[Unit]
Description=Odlat garden app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/odlat
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=ODLAT_DATA=/opt/odlat/data
ExecStart=/usr/bin/node /opt/odlat/server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
