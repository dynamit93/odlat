{
  "name": "odlat",
  "version": "1.0.0",
  "private": true,
  "description": "Svensk odlingsapp för trädgårdsbäddar",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "import:seeds": "node scripts/import-plantagen.js",
    "weather:refresh": "node scripts/refresh-weather.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
